# DeepSeek API (used by Python labeling scripts)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_MAX_TOKENS=4000
DEEPSEEK_BATCH_SIZE=15

# UAPIS hot search API (uapis.cn)
UAPIS_API_KEY=your-uapis-key-here

# Optional local Intel XPU environment path used by training/inference scripts
EMOTION_XPU_ENV=D:/anaconda/envs/emotion_xpu
